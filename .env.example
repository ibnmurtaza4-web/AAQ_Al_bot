# GEMINI_API_KEY: Required for Gemini AI API calls (Gemini Flash models).
GEMINI_API_KEY="AIzaSy..."

# BOT_TOKEN: Telegram Bot Token from @BotFather
BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"

# APP_URL: The public HTTPS URL where this bot is hosted (for Webhook).
APP_URL="https://your-domain-or-cloud-run-url.app"

# ADMIN_SECRET_KEY: Secret key for AAQ Admin Panel authentication
ADMIN_SECRET_KEY="your_secret_admin_key"

# OWNER_USERNAME: Main owner/admin Telegram username
OWNER_USERNAME="your_admin_username"

# PORT: Server HTTP port (default 3000)
PORT=3000
