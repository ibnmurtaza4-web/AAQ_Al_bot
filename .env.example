# GEMINI_API_KEY: Required for Google Gemini AI models (https://aistudio.google.com/apikey)
GEMINI_API_KEY="AIzaSy..."

# OPENROUTER_API_KEY: Optional free key for DeepSeek R1/V3, Llama 3.3 70B, Qwen 2.5 72B (https://openrouter.ai/keys)
OPENROUTER_API_KEY="sk-or-v1-..."

# GROQ_API_KEY: Optional free key for Groq ultra-fast LPU models (https://console.groq.com/keys)
GROQ_API_KEY="gsk_..."

# BOT_TOKEN: Telegram Bot Token from @BotFather
BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"

# APP_URL: The public HTTPS URL where this bot is hosted (for Webhook).
APP_URL="https://your-domain-or-cloud-run-url.app"

# ADMIN_SECRET_KEY: Secret key for AAQ Admin Panel authentication
ADMIN_SECRET_KEY="your_secret_admin_key"

# OWNER_USERNAME: Main owner/admin Telegram username
OWNER_USERNAME="your_admin_username"

# PORT: Server HTTP port (default 3000)
PORT=3000
